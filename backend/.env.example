# =====================================================================
# COOPECA backend — variables d'environnement (EXEMPLE SANS SECRETS)
# ---------------------------------------------------------------------
# Copier vers backend/.env puis renseigner les valeurs locales.
# backend/.env est ignoré par Git et ne doit JAMAIS contenir de secret
# réel versionné. En production, injecter les secrets via le gestionnaire
# de secrets du déploiement, jamais via le dépôt.
# Aucune valeur ci-dessous n'est un identifiant réel.
# =====================================================================

# --- Environnement d'exécution ---
# development | test | production
NODE_ENV=development

# --- API ---
# Port HTTP d'écoute de l'API NestJS.
PORT=3000

# --- Authentification ---
# Générer un secret différent par environnement (au moins 32 caractères).
# Exemple local uniquement ; ne jamais utiliser cette valeur en production.
JWT_SECRET=replace-this-development-secret-with-a-random-value

# --- PostgreSQL ---
# Format : postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
# En développement local avec infra/docker/compose.dev.yml :
#   USER=coopeca  PASSWORD=coopeca_dev_password  HOST=localhost  PORT=5432  DB=coopeca
# En production : utiliser un mot de passe fort unique, un hôte privé,
# et une connexion chiffrée (sslmode=require). Ne jamais connecter le
# squelette à une base de production.
DATABASE_URL=postgresql://coopeca:coopeca_dev_password@localhost:5432/coopeca?schema=public&sslmode=disable

# --- Variables réservées à infra/docker/compose.dev.yml (dev uniquement) ---
# Utilisées uniquement par Docker Compose en local ; ne pas réutiliser en production.
POSTGRES_DB=coopeca
POSTGRES_USER=coopeca
POSTGRES_PASSWORD=coopeca_dev_password
